# ============================================
# Quantum Trading System - Variables d'Environnement
# ============================================
# Copiez ce fichier vers .env :  cp .env.example .env
# ============================================

# === Base de Données ===
# SQLite par défaut (aucune config nécessaire)
DATABASE_URL=sqlite+aiosqlite:///./quantum.db
DATABASE_URL_SYNC=sqlite:///./quantum.db

# === Sécurité & Auth ===
# IMPORTANT: Changez cette clé en production !
JWT_SECRET_KEY=changez-cette-cle-en-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# === Mode ===
# dev = développement local, backtest = backtesting
TRADING_MODE=backtest
LOG_LEVEL=INFO

# ============================================
# C'est tout ! Pas besoin de clés API externes.
# yFinance fonctionne sans clé.
# ============================================
